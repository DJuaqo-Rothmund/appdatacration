#:import theme ui.theme
#:import c ui.theme.c
#:import dp kivy.metrics.dp

# ---------------------------------------------------------------------------
# Piezas base
# ---------------------------------------------------------------------------
<SectionLabel@MDLabel>:
    font_style: "Overline"
    bold: True
    theme_text_color: "Custom"
    text_color: c(theme.OLIVE)
    adaptive_height: True

<Muted@MDLabel>:
    font_style: "Caption"
    theme_text_color: "Custom"
    text_color: c(theme.MUTED)
    adaptive_height: True

<Body@MDLabel>:
    font_style: "Body2"
    theme_text_color: "Custom"
    text_color: c(theme.INK)
    adaptive_height: True

<PaperCard@MDCard>:
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(8)
    radius: [dp(12)]
    elevation: 0
    adaptive_height: True
    md_bg_color: c(theme.PAPER)
    line_color: c(theme.RULE)

<Tag>:
    adaptive_size: True
    padding: dp(8), dp(3)
    font_style: "Caption"
    bold: True
    theme_text_color: "Custom"
    text_color: root.fg
    canvas.before:
        Color:
            rgba: root.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(9)]

<PrimaryButton@MDRaisedButton>:
    md_bg_color: c(theme.OLIVE)
    elevation: 0
    size_hint_x: 1
    height: dp(44)

<GhostButton@MDRectangleFlatIconButton>:
    theme_text_color: "Custom"
    text_color: c(theme.OLIVE_DARK)
    icon_color: c(theme.OLIVE_DARK)
    line_color: c(theme.RULE)
    size_hint_x: 1

<Field@MDTextField>:
    mode: "rectangle"
    line_color_focus: c(theme.OLIVE)
    hint_text_color_focus: c(theme.OLIVE)

<TopBar@MDTopAppBar>:
    elevation: 0
    md_bg_color: c(theme.OLIVE)

# ---------------------------------------------------------------------------
# Home + pestañas
# ---------------------------------------------------------------------------
<HomeScreen>:
    md_bg_color: c(theme.BONE)
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Muestreo semanal"
            right_action_items: [["brain", lambda x: app.open_ai_lab()]]
        MDBottomNavigation:
            id: nav
            panel_color: c(theme.PAPER)
            selected_color_background: c(theme.OLIVE_SOFT)
            text_color_active: c(theme.OLIVE_DARK)
            text_color_normal: c(theme.MUTED)
            MDBottomNavigationItem:
                name: "sampling"
                text: "Muestreo"
                icon: "sprout-outline"
                on_tab_press: root.on_tab("sampling", "Muestreo semanal")
                SamplingTab:
                    id: sampling
            MDBottomNavigationItem:
                name: "varieties"
                text: "Variedades"
                icon: "fruit-cherries"
                on_tab_press: root.on_tab("varieties", "Variedades en ensayo")
                VarietiesTab:
                    id: varieties
            MDBottomNavigationItem:
                name: "reports"
                text: "Informes"
                icon: "file-chart-outline"
                on_tab_press: root.on_tab("reports", "Informes HTML")
                ReportsTab:
                    id: reports
            MDBottomNavigationItem:
                name: "settings"
                text: "Ajustes"
                icon: "cog-outline"
                on_tab_press: root.on_tab("settings", "Ajustes")
                SettingsTab:
                    id: settings

<SamplingTab>:
    orientation: "vertical"
    md_bg_color: c(theme.BONE)
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14), dp(16), dp(24)
            spacing: dp(12)
            PaperCard:
                padding: dp(8), dp(12)
                MDBoxLayout:
                    adaptive_height: True
                    MDIconButton:
                        icon: "chevron-left"
                        pos_hint: {"center_y": .5}
                        on_release: root.shift_week(-1)
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        pos_hint: {"center_y": .5}
                        SectionLabel:
                            id: week_kicker
                            halign: "center"
                            text: "SEMANA 1"
                        MDLabel:
                            id: week_title
                            text: "Semana del 7 de septiembre"
                            halign: "center"
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: c(theme.INK)
                            adaptive_height: True
                        Muted:
                            id: week_range
                            halign: "center"
                    MDIconButton:
                        icon: "chevron-right"
                        pos_hint: {"center_y": .5}
                        on_release: root.shift_week(1)
                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(12), 0
                    spacing: dp(10)
                    MDProgressBar:
                        id: progress
                        max: 1
                        value: 0
                        color: c(theme.OLIVE)
                        back_color: c(theme.OLIVE_SOFT)
                        size_hint_y: None
                        height: dp(6)
                        pos_hint: {"center_y": .5}
                    Muted:
                        id: progress_text
                        size_hint_x: None
                        width: dp(96)
                        halign: "right"
                MDFlatButton:
                    text: "Ir a la semana actual"
                    theme_text_color: "Custom"
                    text_color: c(theme.SLATE)
                    pos_hint: {"center_x": .5}
                    on_release: root.go_current()
            SectionLabel:
                text: "VARIEDADES · toque para registrar"
            MDBoxLayout:
                id: rows
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(8)

<VarietyRow>:
    orientation: "horizontal"
    padding: dp(10)
    spacing: dp(12)
    radius: [dp(12)]
    elevation: 0
    size_hint_y: None
    height: dp(76)
    md_bg_color: c(theme.PAPER)
    line_color: c(theme.RULE)
    ripple_behavior: True
    MDBoxLayout:
        id: thumb_box
        size_hint: None, None
        size: dp(56), dp(56)
        pos_hint: {"center_y": .5}
    MDBoxLayout:
        orientation: "vertical"
        pos_hint: {"center_y": .5}
        adaptive_height: True
        spacing: dp(2)
        MDLabel:
            text: root.title
            font_style: "Subtitle1"
            bold: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
            adaptive_height: True
            shorten: True
        MDLabel:
            text: root.subtitle
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: c(theme.INK_2) if root.done else c(theme.MUTED)
            adaptive_height: True
            shorten: True
    MDBoxLayout:
        orientation: "vertical"
        adaptive_size: True
        spacing: dp(4)
        pos_hint: {"center_y": .5}
        Tag:
            text: root.photo_tag
            bg: c(theme.OLIVE_SOFT) if root.photos == 2 else c(theme.SLATE_SOFT)
            fg: c(theme.OLIVE_DARK) if root.photos == 2 else c(theme.SLATE)
            pos_hint: {"right": 1}
        Tag:
            text: root.code_tag
            bg: root.code_bg
            fg: root.code_fg
            pos_hint: {"right": 1}

<VarietiesTab>:
    md_bg_color: c(theme.BONE)
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14), dp(16), dp(96)
            spacing: dp(8)
            Muted:
                id: season_caption
            MDBoxLayout:
                id: rows
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(8)
    MDFloatingActionButton:
        icon: "plus"
        md_bg_color: c(theme.OLIVE)
        pos_hint: {"right": .95, "y": .03}
        on_release: root.add_dialog()

<VarietyCatalogRow>:
    orientation: "horizontal"
    padding: dp(14), dp(10), dp(4), dp(10)
    spacing: dp(6)
    radius: [dp(12)]
    elevation: 0
    size_hint_y: None
    height: dp(76)
    md_bg_color: c(theme.PAPER)
    line_color: c(theme.RULE)
    ripple_behavior: True
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        spacing: dp(2)
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(8)
            MDLabel:
                text: root.title
                font_style: "Subtitle1"
                bold: True
                adaptive_size: True
                theme_text_color: "Custom"
                text_color: c(theme.INK)
            Tag:
                text: root.code
                opacity: 1 if root.code else 0
                bg: c(theme.SLATE_SOFT)
                fg: c(theme.SLATE)
                pos_hint: {"center_y": .5}
        MDLabel:
            text: root.summary
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
            adaptive_height: True
            shorten: True
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.SLATE)
        on_release: root.tab.open_variety(root.variety_id)
    MDIconButton:
        icon: "delete-outline"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.tab.delete_dialog(root.variety_id)

<ReportsTab>:
    md_bg_color: c(theme.BONE)
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14), dp(16), dp(24)
            spacing: dp(12)
            PaperCard:
                SectionLabel:
                    text: "1 · REPORTE SEMANAL INTER-VARIETAL"
                Muted:
                    text: "Todas las variedades lado a lado: canopia, detalle, estado BBCH y notas."
                GhostButton:
                    id: week_btn
                    icon: "calendar-week"
                    text: "Seleccionar semana"
                    on_release: root.pick_week(self, "week")
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    PrimaryButton:
                        text: "HTML"
                        on_release: root.generate("weekly", "html")
                    PrimaryButton:
                        text: "ZIP portátil"
                        md_bg_color: c(theme.SLATE)
                        on_release: root.generate("weekly", "zip")
            PaperCard:
                SectionLabel:
                    text: "2 · EVOLUCIÓN MENSUAL / RANGO DE SEMANAS"
                Muted:
                    text: "Avance de todas las variedades a lo largo de un mes o rango de semanas."
                GhostButton:
                    id: month_btn
                    icon: "calendar-month"
                    text: "Elegir mes"
                    on_release: root.pick_month(self)
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    GhostButton:
                        id: from_btn
                        icon: "ray-start"
                        text: "Desde"
                        on_release: root.pick_week(self, "from")
                    GhostButton:
                        id: to_btn
                        icon: "ray-end"
                        text: "Hasta"
                        on_release: root.pick_week(self, "to")
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    PrimaryButton:
                        text: "HTML"
                        on_release: root.generate("period", "html")
                    PrimaryButton:
                        text: "ZIP portátil"
                        md_bg_color: c(theme.SLATE)
                        on_release: root.generate("period", "zip")
            PaperCard:
                SectionLabel:
                    text: "3 · FICHA COMPLETA POR VARIEDAD"
                Muted:
                    text: "Timeline de brotación a cosecha con datos biométricos y rendimiento."
                GhostButton:
                    id: variety_btn
                    icon: "fruit-cherries"
                    text: "Seleccionar variedad"
                    on_release: root.pick_variety(self)
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    PrimaryButton:
                        text: "HTML"
                        on_release: root.generate("variety", "html")
                    PrimaryButton:
                        text: "ZIP portátil"
                        md_bg_color: c(theme.SLATE)
                        on_release: root.generate("variety", "zip")
            PaperCard:
                SectionLabel:
                    text: "4 · MATRIZ COMPARATIVA GLOBAL"
                Muted:
                    text: "Heatmap BBCH, precocidad relativa, hitos fenológicos y galería paralela de la temporada."
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    PrimaryButton:
                        text: "HTML"
                        on_release: root.generate("matrix", "html")
                    PrimaryButton:
                        text: "ZIP portátil"
                        md_bg_color: c(theme.SLATE)
                        on_release: root.generate("matrix", "zip")
            SectionLabel:
                text: "INFORMES GENERADOS"
            MDBoxLayout:
                id: recent
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(6)

<ReportRow>:
    orientation: "horizontal"
    padding: dp(14), dp(6), dp(4), dp(6)
    radius: [dp(10)]
    elevation: 0
    size_hint_y: None
    height: dp(60)
    md_bg_color: c(theme.PAPER)
    line_color: c(theme.RULE)
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        MDLabel:
            text: root.title
            font_style: "Body2"
            bold: True
            adaptive_height: True
            shorten: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
        MDLabel:
            text: root.meta
            font_style: "Caption"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
    MDIconButton:
        icon: "open-in-new"
        pos_hint: {"center_y": .5}
        on_release: app.open_file(root.path)
    MDIconButton:
        icon: "share-variant-outline"
        pos_hint: {"center_y": .5}
        on_release: app.share_file(root.path)

<SettingsTab>:
    md_bg_color: c(theme.BONE)
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14), dp(16), dp(24)
            spacing: dp(12)
            PaperCard:
                SectionLabel:
                    text: "RECORDATORIO DE MUESTREO"
                MDBoxLayout:
                    adaptive_height: True
                    Body:
                        text: "Activar recordatorios"
                        pos_hint: {"center_y": .5}
                    MDSwitch:
                        id: enabled
                        pos_hint: {"center_y": .5}
                        on_active: root.on_toggle(self.active)
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    GhostButton:
                        id: day_btn
                        icon: "calendar-today"
                        text: "Viernes"
                        on_release: root.pick_day(self)
                    GhostButton:
                        id: time_btn
                        icon: "clock-outline"
                        text: "09:00"
                        on_release: root.pick_time()
                GhostButton:
                    id: freq_btn
                    icon: "repeat"
                    text: "Semanal"
                    on_release: root.pick_freq(self)
                Muted:
                    id: next_text
                MDBoxLayout:
                    id: exact_box
                    adaptive_height: True
                    spacing: dp(8)
            PaperCard:
                SectionLabel:
                    text: "TEMPORADA Y SEMANAS DE MUESTREO"
                Body:
                    id: season_text
                GhostButton:
                    id: start_btn
                    icon: "calendar-start"
                    text: "Semana 1"
                    on_release: root.pick_start()
                Muted:
                    text: "Las semanas siguientes se generan en forma secuencial cada 7 días desde la Semana 1."
            PaperCard:
                SectionLabel:
                    text: "INTELIGENCIA ARTIFICIAL (EDGE AI)"
                Body:
                    id: ai_text
                GhostButton:
                    icon: "lock-outline"
                    text: "Módulo de calibración (PIN)"
                    on_release: app.open_ai_lab()
            PaperCard:
                SectionLabel:
                    text: "TRAZABILIDAD Y DATOS"
                Muted:
                    id: data_text
                GhostButton:
                    icon: "history"
                    text: "Ver bitácora de cambios"
                    on_release: root.show_audit()
                GhostButton:
                    icon: "database-export-outline"
                    text: "Respaldar base de datos"
                    on_release: root.backup()

# ---------------------------------------------------------------------------
# Registro fenológico
# ---------------------------------------------------------------------------
<PhotoSlot>:
    orientation: "vertical"
    padding: dp(10)
    spacing: dp(6)
    radius: [dp(12)]
    elevation: 0
    size_hint_y: None
    height: dp(250)
    md_bg_color: c(theme.PAPER)
    line_color: c(theme.RULE)
    SectionLabel:
        text: root.caption
        shorten: True
    MDBoxLayout:
        id: image_box
    Muted:
        text: root.meta
        shorten: True
    MDBoxLayout:
        adaptive_height: True
        spacing: dp(4)
        MDIconButton:
            icon: "camera-outline"
            theme_icon_color: "Custom"
            icon_color: c(theme.OLIVE_DARK)
            on_release: root.screen.capture(root.kind, "camera")
        MDIconButton:
            icon: "image-outline"
            theme_icon_color: "Custom"
            icon_color: c(theme.OLIVE_DARK)
            on_release: root.screen.capture(root.kind, "gallery")
        Widget:
        MDIconButton:
            icon: "delete-outline"
            disabled: not root.has_photo
            theme_icon_color: "Custom"
            icon_color: c(theme.BERRY)
            on_release: root.screen.remove_photo(root.kind)

<ObservationScreen>:
    md_bg_color: c(theme.BONE)
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Registro"
            left_action_items: [["arrow-left", lambda x: app.back()]]
            right_action_items: [["content-save-outline", lambda x: root.save()]]
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16), dp(12), dp(16), dp(32)
                spacing: dp(12)
                Muted:
                    id: week_caption
                MDGridLayout:
                    cols: 2
                    spacing: dp(10)
                    adaptive_height: True
                    PhotoSlot:
                        id: canopy
                        kind: "canopy"
                        caption: "FOTO 1 · CANOPIA"
                        screen: root
                    PhotoSlot:
                        id: detail
                        kind: "detail"
                        caption: "FOTO 2 · DETALLE"
                        screen: root
                PaperCard:
                    SectionLabel:
                        text: "SUGERENCIA AUTOMÁTICA (IA LOCAL)"
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        MDSpinner:
                            id: spinner
                            size_hint: None, None
                            size: dp(22), dp(22)
                            active: False
                            opacity: 1 if self.active else 0
                            color: c(theme.OLIVE)
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            id: ai_label
                            text: "Suba la foto de detalle para obtener una sugerencia."
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True
                            theme_text_color: "Custom"
                            text_color: c(theme.INK)
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        MDProgressBar:
                            id: ai_conf
                            max: 1
                            value: 0
                            color: c(theme.OLIVE)
                            back_color: c(theme.OLIVE_SOFT)
                            size_hint_y: None
                            height: dp(6)
                            pos_hint: {"center_y": .5}
                        Muted:
                            id: ai_conf_text
                            size_hint_x: None
                            width: dp(90)
                            halign: "right"
                    Muted:
                        id: ai_explain
                    MDBoxLayout:
                        id: alternatives
                        adaptive_height: True
                        spacing: dp(6)
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)
                        PrimaryButton:
                            id: accept_btn
                            text: "Aceptar sugerencia"
                            disabled: True
                            on_release: root.accept_ai()
                        GhostButton:
                            icon: "refresh"
                            text: "Re-analizar"
                            on_release: root.analyze()
                PaperCard:
                    SectionLabel:
                        text: "ESTADO FENOLÓGICO Y OBSERVACIONES"
                    Field:
                        id: bbch
                        hint_text: "Estado fenológico (BBCH)"
                        helper_text: "Toque el ícono para elegir de la escala o escriba libremente"
                        helper_text_mode: "on_focus"
                        icon_right: "format-list-bulleted"
                    GhostButton:
                        icon: "format-list-numbered"
                        text: "Elegir de la escala BBCH"
                        on_release: root.open_scale(self)
                    Field:
                        id: notes
                        hint_text: "Notas y observaciones técnicas"
                        multiline: True
                        max_height: dp(180)
                    Muted:
                        id: stamp
                PrimaryButton:
                    text: "Guardar registro"
                    on_release: root.save()

# ---------------------------------------------------------------------------
# Ficha de variedad
# ---------------------------------------------------------------------------
<ValueUnitRow@MDBoxLayout>:
    adaptive_height: True
    spacing: dp(8)

<UnitButton>:
    size_hint_x: None
    width: dp(128)
    pos_hint: {"center_y": .5}
    theme_text_color: "Custom"
    text_color: c(theme.SLATE)
    line_color: c(theme.RULE)

<VarietyScreen>:
    md_bg_color: c(theme.BONE)
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Variedad"
            left_action_items: [["arrow-left", lambda x: app.back()]]
            right_action_items: [["content-save-outline", lambda x: root.save()]]
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16), dp(12), dp(16), dp(32)
                spacing: dp(12)
                PaperCard:
                    SectionLabel:
                        text: "IDENTIFICACIÓN"
                    Field:
                        id: name
                        hint_text: "Nombre de la variedad"
                    Field:
                        id: code
                        hint_text: "Código / abreviatura"
                    Field:
                        id: notes
                        hint_text: "Notas (origen, manejo, parcela...)"
                        multiline: True
                PaperCard:
                    SectionLabel:
                        id: metrics_title
                        text: "PARÁMETROS BIOMÉTRICOS"
                    ValueUnitRow:
                        Field:
                            id: historical_yield
                            hint_text: "Rendimiento histórico"
                            input_filter: "float"
                        UnitButton:
                            id: historical_yield_unit
                            options: ["kg/planta", "t/ha", "kg/m lineal"]
                    Field:
                        id: historical_note
                        hint_text: "Temporadas de referencia (ej. prom. 2023-2025)"
                    ValueUnitRow:
                        Field:
                            id: projected_yield
                            hint_text: "Proyección temporada actual"
                            input_filter: "float"
                        UnitButton:
                            id: projected_yield_unit
                            options: ["kg/planta", "t/ha", "kg/m lineal"]
                    ValueUnitRow:
                        Field:
                            id: basal_canes
                            hint_text: "Cañas basales"
                            input_filter: "float"
                        UnitButton:
                            id: basal_canes_unit
                            options: ["por planta", "por m lineal"]
                    ValueUnitRow:
                        Field:
                            id: laterals
                            hint_text: "Laterales reproductivos"
                            input_filter: "float"
                        UnitButton:
                            id: laterals_unit
                            options: ["por caña", "por planta", "por m lineal"]
                PaperCard:
                    SectionLabel:
                        text: "CAMPOS PERSONALIZADOS"
                    Muted:
                        text: "Ej.: Diámetro de caña (mm), Grados Brix, Incidencia fitosanitaria (%)."
                    MDBoxLayout:
                        id: custom
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(4)
                    GhostButton:
                        icon: "plus"
                        text: "Agregar campo"
                        on_release: root.custom_dialog()
                PrimaryButton:
                    text: "Guardar ficha"
                    on_release: root.save()
                GhostButton:
                    icon: "file-chart-outline"
                    text: "Generar ficha HTML de la variedad"
                    on_release: root.report()

<CustomFieldRow>:
    adaptive_height: True
    spacing: dp(6)
    padding: dp(4), 0
    MDLabel:
        text: root.key
        font_style: "Body2"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.INK_2)
    MDLabel:
        text: root.value
        font_style: "Body2"
        bold: True
        halign: "right"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.INK)
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        on_release: root.screen.custom_dialog(root.field)
    MDIconButton:
        icon: "close"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.screen.delete_custom(root.field_id)

<CustomFieldForm>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(8)
    padding: 0, dp(8), 0, 0
    Field:
        id: key
        hint_text: "Nombre del parámetro"
    Field:
        id: value
        hint_text: "Valor"
    Field:
        id: unit
        hint_text: "Unidad (opcional)"
    MDBoxLayout:
        id: suggestions
        adaptive_height: True
        spacing: dp(4)

<VarietyForm>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(8)
    padding: 0, dp(8), 0, 0
    Field:
        id: name
        hint_text: "Nombre de la variedad"
    Field:
        id: code
        hint_text: "Código (opcional)"

<PinForm>:
    orientation: "vertical"
    adaptive_height: True
    padding: 0, dp(8), 0, 0
    spacing: dp(6)
    Field:
        id: pin
        hint_text: "PIN numérico"
        password: True
        input_filter: "int"
        max_text_length: 8
    Muted:
        id: msg

# ---------------------------------------------------------------------------
# Módulo de calibración IA
# ---------------------------------------------------------------------------
<SegButton>:
    size_hint_x: 1
    elevation: 0
    md_bg_color: c(theme.OLIVE) if self.selected else c(theme.PAPER)
    theme_text_color: "Custom"
    text_color: (1, 1, 1, 1) if self.selected else c(theme.OLIVE_DARK)
    line_color: c(theme.RULE)

<AILabScreen>:
    md_bg_color: c(theme.BONE)
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            title: "Calibración IA"
            md_bg_color: c(theme.SLATE)
            left_action_items: [["arrow-left", lambda x: app.back()]]
            right_action_items: [["lock-outline", lambda x: app.back()]]
        MDBoxLayout:
            adaptive_height: True
            padding: dp(16), dp(12), dp(16), dp(4)
            spacing: dp(6)
            SegButton:
                text: "Documentos"
                selected: seg.current == "docs"
                on_release: root.show("docs")
            SegButton:
                text: "Etiquetado"
                selected: seg.current == "label"
                on_release: root.show("label")
            SegButton:
                text: "Modelo"
                selected: seg.current == "model"
                on_release: root.show("model")
        MDScreenManager:
            id: seg
            MDScreen:
                name: "docs"
                MDScrollView:
                    do_scroll_x: False
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16), dp(8), dp(16), dp(24)
                        spacing: dp(10)
                        PaperCard:
                            SectionLabel:
                                text: "DOCUMENTOS TÉCNICOS DE REFERENCIA"
                            Muted:
                                text: "Cargue PDF o texto con claves fenológicas (p. ej. «BBCH 65: Plena floración...»). Las claves detectadas enriquecen la escala BBCH y el análisis de las notas de campo."
                            PrimaryButton:
                                text: "Cargar documento (PDF / TXT)"
                                on_release: root.import_document()
                            GhostButton:
                                icon: "format-list-numbered"
                                text: "Ver escala BBCH en uso"
                                on_release: root.show_scale()
                        MDBoxLayout:
                            id: docs
                            orientation: "vertical"
                            adaptive_height: True
                            spacing: dp(6)
            MDScreen:
                name: "label"
                MDScrollView:
                    do_scroll_x: False
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16), dp(8), dp(16), dp(24)
                        spacing: dp(10)
                        PaperCard:
                            SectionLabel:
                                text: "ETIQUETADO DE FOTOS (FEW-SHOT)"
                            Muted:
                                text: "Toque una foto de detalle para asignarle su estado fenológico real y agregarla a la base de referencia del clasificador k-NN."
                            MDBoxLayout:
                                adaptive_height: True
                                Body:
                                    text: "Aprendizaje continuo al guardar registros"
                                    pos_hint: {"center_y": .5}
                                MDSwitch:
                                    id: auto_learn
                                    pos_hint: {"center_y": .5}
                                    on_active: root.set_auto_learn(self.active)
                            GhostButton:
                                icon: "playlist-plus"
                                text: "Agregar todas las fotos ya etiquetadas"
                                on_release: root.add_all_labeled()
                        MDBoxLayout:
                            id: photos
                            orientation: "vertical"
                            adaptive_height: True
                            spacing: dp(6)
            MDScreen:
                name: "model"
                MDScrollView:
                    do_scroll_x: False
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16), dp(8), dp(16), dp(24)
                        spacing: dp(10)
                        PaperCard:
                            SectionLabel:
                                text: "CLASIFICADOR LOCAL"
                            Body:
                                id: model_text
                            Muted:
                                id: eval_text
                            MDProgressBar:
                                id: train_progress
                                max: 1
                                value: 0
                                color: c(theme.SLATE)
                                size_hint_y: None
                                height: dp(4)
                            PrimaryButton:
                                text: "Evaluar (validación cruzada)"
                                on_release: root.evaluate()
                            GhostButton:
                                icon: "cog-refresh-outline"
                                text: "Re-entrenar (recalcular embeddings)"
                                on_release: root.retrain()
                        PaperCard:
                            SectionLabel:
                                text: "REFERENCIAS POR ESTADO BBCH"
                            MDBoxLayout:
                                id: counts
                                orientation: "vertical"
                                adaptive_height: True
                                spacing: dp(2)
                        PaperCard:
                            SectionLabel:
                                text: "SEGURIDAD"
                            GhostButton:
                                icon: "form-textbox-password"
                                text: "Cambiar PIN"
                                on_release: root.change_pin()

<LabelPhotoRow>:
    orientation: "horizontal"
    padding: dp(8)
    spacing: dp(10)
    radius: [dp(10)]
    elevation: 0
    size_hint_y: None
    height: dp(72)
    md_bg_color: c(theme.PAPER)
    line_color: c(theme.RULE)
    ripple_behavior: True
    MDBoxLayout:
        id: thumb_box
        size_hint: None, None
        size: dp(56), dp(56)
        pos_hint: {"center_y": .5}
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        MDLabel:
            text: root.title
            font_style: "Body2"
            bold: True
            adaptive_height: True
            shorten: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
        MDLabel:
            text: root.subtitle
            font_style: "Caption"
            adaptive_height: True
            shorten: True
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
    Tag:
        text: "EN REFERENCIA" if root.in_reference else "SIN ETIQUETA IA"
        bg: c(theme.OLIVE_SOFT) if root.in_reference else c(theme.SLATE_SOFT)
        fg: c(theme.OLIVE_DARK) if root.in_reference else c(theme.SLATE)
        pos_hint: {"center_y": .5}
